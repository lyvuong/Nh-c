# Copy this file to .env (or .env.local) and fill in your own values.
# .env is gitignored - your key will never be committed.
#
# These are read at BUILD time (vite build / vite dev) and get baked into the
# shipped JS bundle, so anyone can view them in browser devtools. That's fine
# for a Google API key IF you restrict it in Google Cloud Console:
#   - Restrict to the "Google Drive API" only
#   - Restrict by HTTP referrer to your deployed domain (and localhost while developing)
# Never put a secret that needs to stay private in here.

# Google API key with the Drive API enabled. Lets the app read any Drive folder
# shared as "Anyone with the link", without the user having to sign in or
# paste in a key themselves. Create one at:
# https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_DRIVE_API_KEY=

# Optional: the shared folder's URL, pre-filled so users don't have to paste it either.
# https://drive.google.com/drive/folders/XXXXXXXXXXXXXXXXXXXX
VITE_GOOGLE_DRIVE_FOLDER_URL=
